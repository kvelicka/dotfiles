alias ll='ls -lh'
alias l='ll'
alias la='ls -lah'

alias tmux='tmux -2'
# TODO make cross-platform
alias nnn='nautilus . --no-desktop'

# Ubuntu
alias install='sudo apt install -y'
alias update='sudo apt update'
alias upgrade='sudo apt upgrade'
alias remove='sudo apt remove'

# Erlang
alias r3='rebar3'

# Vim
alias v='nvim'
alias nv='nvim'
alias vimrc='vi ~/.vimrc'


# Git
alias   g='git'
alias  gp='git push'
alias  gl='git pull'
alias  gf='git fetch'
alias  gs='git status'
alias  gd='git diff'
alias  ga='git add'
alias  gc='git commit -v'
alias gca='git commit -v -a'
alias gco='git checkout'
alias gdd='DFT_DISPLAY=side-by-side GIT_EXTERNAL_DIFF=difft git diff'
alias gddv='DFT_DISPLAY=inline GIT_EXTERNAL_DIFF=difft git diff'
alias gcp='git cherry-pick'
alias gcl='git clone --recursive'
alias grb='git rebase'
alias grbmh='git rebase -i $(git merge-base HEAD origin/master)'
